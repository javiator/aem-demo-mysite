<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/mysite/settings/wcm/templates/page-content"
        jcr:primaryType="cq:PageContent"
        jcr:title="AI in Architecture"
        sling:resourceType="mysite/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="mysite/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="mysite/components/container">
                <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/container"
                    layout="responsiveGrid">
                    <hero
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="mysite/components/hero"
                        alignment="left"
                        alt="Modern Architecture with AI"
                        fileReference="/content/dam/mysite/ai-tech/hero-architecture.jpg"
                        minHeight="600"
                        overlayOpacity="0.4">
                        <title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="mysite/components/title"
                            jcr:title="AI in Architecture"
                            type="h1"/>
                        <text
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="mysite/components/text"
                            text="&lt;p&gt;Revolutionizing the way we design and build smart cities.&lt;/p&gt;"
                            textIsRich="true"/>
                        <button
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="mysite/components/button"
                            jcr:title="Learn More"
                            link="/content/mysite/us/en/ai-in-architecture"/>
                    </hero>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="mysite/components/text"
                        text="&lt;h2&gt;Generative Design and Smart Cities&lt;/h2&gt;&lt;p&gt;Artificial Intelligence is transforming architecture through generative design, allowing architects to explore thousands of design options in minutes. By optimizing for factors like light, airflow, and structural integrity, AI helps create more sustainable and efficient buildings.&lt;/p&gt;"
                        textIsRich="true"/>
                    <teaser
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="mysite/components/teaser"
                        actionsEnabled="true"
                        descriptionFromPage="false"
                        fileReference="/content/dam/mysite/ai-tech/content-architecture.jpg"
                        jcr:description="&lt;p&gt;Explore how AI tools are being used to create the blueprints of the future.&lt;/p&gt;"
                        jcr:title="The Future of Blueprints"
                        textIsRich="true"
                        titleFromPage="false">
                        <actions jcr:primaryType="nt:unstructured">
                            <item0
                                jcr:primaryType="nt:unstructured"
                                link="/content/mysite/us/en"
                                text="Read Case Study"/>
                        </actions>
                    </teaser>
                    <image
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="mysite/components/image"
                        fileReference="/content/dam/mysite/ai-tech/content-architecture.jpg"
                        alt="Architects using AI"/>
                </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
